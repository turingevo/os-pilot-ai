# 开发者本机配置（构建期）。在仓库根 source 一次，之后 pack/ 与 ime/ 与 tools/ 下的脚本
# 直接可跑，不用再带环境变量前缀：
#
#     cp dev.env.sh.example dev.env.sh   # dev.env.sh 已 gitignore，写你机器的真实路径
#     . ./dev.env.sh
#
# 这里只放「我是谁、我的机器什么样」这一类长期不变的构建期变量（用裸 export，代表开发
# 环境的权威定义）；单次运行的旋钮不要写进来，名单见文件末尾。

# 同一 shell 里重复 source 直接返回，不会盖掉你之后临时改过的那几个值
if [ -n "${VTOY_AI_DEV_ENV_LOADED:-}" ]; then return 0; fi

# ---------- 构建目录与源码位置（不给则回落 ~/.cache/ventoy-ai 并打提示） ----------
export VTOY_AI_BUILD_DIR=/path/to/ventoy-ai-build
export VTOY_AI_BUSYBOX_SRC=/path/to/busybox-1.36.1    # 已有源码树；不给则 build_busybox.sh 自动下载
export VTOY_AI_LLAMA_SRC=/path/to/llama.cpp           # 已有源码树；不给则 build_llama.sh 自动下载归档
export VTOY_AI_VENTOY_RELEASE=/path/to/ventoy-1.1.05  # 仅 make_ventoy_testdisk.sh 需要
export VTOY_AI_MTOOLS_DIR=/path/to/mtools             # 仅 find_mtools.sh 需要（不给则自行定位）

# ---------- 本机资源 ----------
export VTOY_AI_BUILD_JOBS=8        # 并行度，默认 nproc；给太高会触发编译器瞬时故障
export VTOY_AI_QEMU_MEM=6144       # 默认 4096；经 Ventoy 引导桌面版目标 ISO 时 4G 不够
export VTOY_AI_QEMU_SMP=4
# export VTOY_AI_QEMU_ACCEL='-accel tcg'   # 默认自动探测 /dev/kvm；这行取消注释即强制纯模拟

# ---------- 下载源（按网络环境换；不带注释的那行就是脚本里的默认值） ----------
export VTOY_AI_KERNEL_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ubuntu
export VTOY_AI_BUSYBOX_MIRROR=https://busybox.net/downloads
export VTOY_AI_IME_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ubuntu
export VTOY_AI_LLAMA_MIRROR=https://github.com/ggml-org/llama.cpp/archive
# export VTOY_AI_LLM_ENDPOINT=https://hf-mirror.com   # tools/fetch_local_llm.sh 的模型站
# export VTOY_AI_LLAMA_SHA256=<sha256>                # 换本地编译的 llama.cpp 归档时才需要

VTOY_AI_DEV_ENV_LOADED=1   # 与上面的守卫配对：标记本机配置已进环境

# ---------- 不要写在这里（单次旋钮，用命令行前缀或位置参数） ----------
# 跑一次就换的：VTOY_AI_QEMU_TIMEOUT VTOY_AI_INTERACTIVE VTOY_AI_USB_MODE VTOY_AI_TARGET_MODE
#   VTOY_AI_USB_IF VTOY_AI_TARGET_IF VTOY_AI_SCRATCH_IF VTOY_AI_DISK_IF VTOY_AI_SCRATCH_MB
#   VTOY_AI_TOOLS_FORCE VTOY_AI_SKIP_ISO_BUILD VTOY_AI_KEEP_PAYLOAD VTOY_AI_WITH_SCRIPT
#   VTOY_AI_SCRIPT_FILE VTOY_AI_BASE_URL VTOY_AI_MODEL VTOY_AI_REQUEST_TIMEOUT VTOY_AI_MOCK_PORT
#   VTOY_AI_DISK_MB VTOY_AI_TARGET_IMG VTOY_AI_DISK VTOY_AI_SERIAL_LOG VTOY_AI_TARGET_LOG
# 换内核版本时改的是代码不是环境：版本名硬编码在 pack/fetch_kernel.sh:23（VTOY_AI_KVER 只影响
#   pack_env.sh 找模块树，单边改会让打包失败）
# 产品运行期变量（VTOY_AI_SCREEN / _NO_REBOOT / _API_KEY / _IME_* / _LOCAL_LLM*）属于 guest 里的
#   ai.json 与 ventoy.json，跟构建无关，别放这儿
